<li class="qw-row {{#if this.isHidden}}is-hidden-quest{{/if}} {{#if this.isMine}}is-mine{{/if}}"
    data-quest-uuid="{{this.uuid}}">

  <div class="qw-row-status" style="--qw-chip:{{this.color}}"
       data-tooltip="{{localize this.statusLabel}}">
    <i class="fa-solid {{this.icon}}"></i>
  </div>

  {{#if this.img}}<img class="qw-row-img" src="{{this.img}}" alt="" data-action="openQuest">{{/if}}

  <div class="qw-row-main">
    <div class="qw-row-title" data-action="openQuest">
      <span class="qw-row-name">{{this.name}}</span>
      {{#if this.giver.name}}<span class="qw-row-giver">· {{this.giver.name}}</span>{{/if}}
      {{#if this.suggestedBy}}
      <span class="qw-chip qw-proposed" data-tooltip="{{localize 'QW.Propose.ByTooltip'}}">
        <i class="fa-solid fa-feather"></i> {{this.suggestedBy}}
      </span>
      {{/if}}
      {{#if @root.isGM}}
        {{#if this.isHidden}}
        <i class="fa-solid fa-eye-slash qw-hidden-flag" data-tooltip="{{localize 'QW.Quest.HiddenFromAll'}}"></i>
        {{/if}}
      {{/if}}
    </div>

    {{#if this.progress.total}}
    <div class="qw-progress qw-progress-slim"
         role="progressbar" aria-valuenow="{{this.progress.pct}}" aria-valuemin="0" aria-valuemax="100">
      <div class="qw-progress-bar" style="width:{{this.progress.pct}}%"></div>
      <span class="qw-progress-label">{{this.progress.done}} / {{this.progress.total}}</span>
    </div>
    {{/if}}

    {{#if this.milestones.length}}
    <ul class="qw-row-milestones">
      {{#each this.milestones}}
      <li class="qw-row-ms {{#if this.done}}is-done{{/if}}">
        {{#if @root.canTick}}
        <input type="checkbox" data-action="toggleMilestone" data-milestone-id="{{this.id}}"
               {{checked this.done}} aria-label="{{this.text}}">
        {{else}}
        <i class="fa-solid {{#if this.done}}fa-square-check{{else}}fa-square{{/if}}"></i>
        {{/if}}
        <span>{{this.text}}</span>
        {{#if this.counter.max}}<span class="qw-counter">{{this.counter.value}}/{{this.counter.max}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}

    <div class="qw-row-foot">
      {{#each this.coins}}<span class="qw-coin qw-coin-{{this.key}}">{{this.value}} {{this.key}}</span>{{/each}}
      {{#if this.xp}}<span class="qw-coin qw-coin-xp">{{this.xp}} XP</span>{{/if}}
      {{#each this.items}}
      <span class="qw-reward-pill">
        {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}{{#if (gt this.qty 1)}} ×{{this.qty}}{{/if}}
      </span>
      {{/each}}
      {{#each this.tags}}<span class="qw-chip qw-chip-tag">{{this}}</span>{{/each}}
      {{#if this.suggestedReward}}
      <span class="qw-chip qw-suggested-reward" data-tooltip="{{localize 'QW.Propose.RewardTooltip'}}">
        <i class="fa-solid fa-hand-holding-heart"></i> {{this.suggestedReward}}
      </span>
      {{/if}}
    </div>
  </div>

  <div class="qw-row-side">
    {{#if this.assignees.length}}
    <div class="qw-row-party">
      {{#each this.assignees}}
      <img src="{{this.img}}" alt="{{this.name}}" data-tooltip="{{this.name}}">
      {{/each}}
    </div>
    {{/if}}

    <div class="qw-row-actions">
      {{#if @root.isGM}}
      {{#if this.hasRewards}}
      <button type="button" class="qw-icon-btn" data-action="awardQuest"
              data-tooltip="{{localize 'QW.Award.Title'}}">
        <i class="fa-solid fa-sack-dollar"></i>
      </button>
      {{/if}}
      <button type="button" class="qw-icon-btn" data-action="toggleVisibility"
              data-tooltip="{{#if this.isHidden}}{{localize 'QW.Log.ShowToPlayers'}}{{else}}{{localize 'QW.Log.HideFromPlayers'}}{{/if}}">
        <i class="fa-solid {{#if this.isHidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
      </button>
      <button type="button" class="qw-icon-btn qw-danger" data-action="deleteQuest"
              data-tooltip="{{localize 'QW.Log.Delete'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
      {{else if (and @root.canAbandon this.isMine)}}
      <button type="button" class="qw-icon-btn" data-action="abandonQuest"
              data-tooltip="{{localize 'QW.Log.Abandon'}}">
        <i class="fa-solid fa-circle-minus"></i>
      </button>
      {{/if}}
    </div>
  </div>

</li>
