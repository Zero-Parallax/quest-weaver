<div class="qw-web-shell">

  <div class="qw-web-toolbar">
    <div class="qw-web-picker">
      <select name="qw-web-select" aria-label="{{localize 'QW.Web.Title'}}">
        {{#each webs}}
        <option value="{{this.uuid}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" class="qw-icon-btn" data-action="newWeb"
              data-tooltip="{{localize 'QW.Web.NewWeb'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{#if hasWeb}}
      <button type="button" class="qw-icon-btn" data-action="renameWeb"
              data-tooltip="{{localize 'QW.Web.Rename'}}">
        <i class="fa-solid fa-pen"></i>
      </button>
      <button type="button" class="qw-icon-btn qw-danger" data-action="deleteWeb"
              data-tooltip="{{localize 'QW.Web.DeleteWeb'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
      {{/if}}
    </div>

    {{#if hasWeb}}
    <div class="qw-web-tools">
      <button type="button" class="qw-add-btn" data-action="addQuest">
        <i class="fa-solid fa-scroll"></i> {{localize "QW.Web.AddQuest"}}
      </button>
      <button type="button" class="qw-add-btn" data-action="addAllQuests">
        <i class="fa-solid fa-layer-group"></i> {{localize "QW.Web.AddAllQuests"}}
      </button>
      <button type="button" class="qw-add-btn" data-action="addNode">
        <i class="fa-solid fa-note-sticky"></i> {{localize "QW.Web.AddNode"}}
      </button>
      <span class="qw-web-sep"></span>
      <button type="button" class="qw-add-btn" data-action="autoLayout">
        <i class="fa-solid fa-sitemap"></i> {{localize "QW.Web.AutoLayout"}}
      </button>
      <button type="button" class="qw-icon-btn" data-action="fitView"
              data-tooltip="{{localize 'QW.Web.Fit'}}">
        <i class="fa-solid fa-expand"></i>
      </button>
      <button type="button" class="qw-icon-btn {{#if snap}}is-on{{/if}}" data-action="toggleSnap"
              data-tooltip="{{localize 'QW.Web.Snap'}}">
        <i class="fa-solid fa-table-cells"></i>
      </button>
    </div>
    {{/if}}
  </div>

  {{#if hasWeb}}
  <div class="qw-web-canvas-host"></div>
  <p class="qw-web-hint">
    <i class="fa-solid fa-circle-info"></i> {{localize "QW.Web.CanvasHint"}}
  </p>
  {{else}}
  <p class="qw-empty">
    <i class="fa-solid fa-diagram-project"></i>
    {{localize "QW.Web.NoWebs"}}
  </p>
  {{/if}}

</div>
